---
// LinkForm.astro — main link creation form
---

<form class="lf-form" id="linkForm" novalidate>
  <div class="lf-field-group">
    <label class="lf-label" for="lf-url">
      <span class="lf-label-line"></span>
      url original
    </label>
    <div class="lf-input-wrapper" id="wrapper-url">
      <span class="lf-prefix">https://</span>
      <input
        id="lf-url"
        name="url"
        type="url"
        inputmode="url"
        placeholder="ejemplo.com/ruta"
        autocomplete="off"
        spellcheck="false"
        aria-describedby="lf-error-msg"
      />
    </div>
  </div>

  <div class="lf-field-group">
    <label class="lf-label" for="lf-alias">
      <span class="lf-label-line"></span>
      alias personalizado
      <span class="lf-badge">required</span>
    </label>
    <div class="lf-input-wrapper" id="wrapper-alias">
      <span class="lf-prefix">linksy.io/</span>
      <input
        id="lf-alias"
        name="alias"
        type="text"
        placeholder="mi-link"
        autocomplete="off"
        spellcheck="false"
        maxlength="64"
      />
      <span class="lf-counter" id="lf-alias-counter" aria-hidden="true">0/64</span>
    </div>
  </div>

  <button type="submit" class="lf-button" id="lf-submit" disabled aria-busy="false">
    <span class="lf-button-content" id="lf-btn-content">
      <span class="lf-arrow">→</span>
      crear link
    </span>
  </button>
</form>

<div class="lf-result hidden" id="lf-result" role="status" aria-live="polite">
  <div class="lf-result-row">
    <span class="lf-result-label">
      <span class="lf-label-line"></span>
      link generado
    </span>
    <button class="lf-copy-btn" id="lf-copy-btn" title="Copiar enlace" aria-label="Copiar enlace al portapapeles">
      <span id="lf-copy-icon" aria-hidden="true">⎘</span>
    </button>
  </div>
  <a id="lf-result-url" class="lf-result-url" href="#" target="_blank" rel="noopener noreferrer"></a>
  <a id="lf-stats-link" class="lf-stats-anchor" href="#">
    ver estadísticas
    <span aria-hidden="true">→</span>
  </a>
</div>

<div class="lf-error hidden" id="lf-error" role="alert" aria-live="assertive">
  <span class="lf-label-line"></span>
  <span id="lf-error-msg"></span>
</div>

<div class="lf-footer">
  <span class="lf-footer-text">v1.0 · estable</span>
  <div class="lf-footer-dots" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
</div>

<script>
  import { createLink } from '../lib/api';

  const form         = document.getElementById("linkForm") as HTMLFormElement;
  const urlInput     = document.getElementById("lf-url") as HTMLInputElement;
  const aliasInput   = document.getElementById("lf-alias") as HTMLInputElement;
  const aliasCounter = document.getElementById("lf-alias-counter")!;
  const submitBtn    = document.getElementById("lf-submit") as HTMLButtonElement;
  const btnContent   = document.getElementById("lf-btn-content")!;
  const resultBlock  = document.getElementById("lf-result")!;
  const resultUrl    = document.getElementById("lf-result-url") as HTMLAnchorElement;
  const errorBlock   = document.getElementById("lf-error")!;
  const errorMsg     = document.getElementById("lf-error-msg")!;
  const copyBtn      = document.getElementById("lf-copy-btn")!;
  const copyIcon     = document.getElementById("lf-copy-icon")!;
  const statsLink    = document.getElementById("lf-stats-link") as HTMLAnchorElement;

  document.querySelectorAll<HTMLInputElement>(".lf-input-wrapper input").forEach((input) => {
    const wrapper = input.closest(".lf-input-wrapper")!;
    input.addEventListener("focus", () => wrapper.classList.add("focused"));
    input.addEventListener("blur",  () => wrapper.classList.remove("focused"));
  });

  const updateAliasCounter = () => {
    aliasCounter.textContent = `${aliasInput.value.length}/64`;
  };
  aliasInput.addEventListener("input", updateAliasCounter);

  urlInput.addEventListener("input", () => {
    submitBtn.disabled = urlInput.value.trim() === "";
    hideResult();
    hideError();
  });

  function setLoading() {
    submitBtn.disabled = true;
    submitBtn.setAttribute("aria-busy", "true");
    submitBtn.classList.add("loading");
    btnContent.innerHTML = `
      <span class="lf-dot-1"></span>
      <span class="lf-dot-2"></span>
      <span class="lf-dot-3"></span>
    `;
  }

  function setSuccess() {
    submitBtn.classList.remove("loading");
    submitBtn.setAttribute("aria-busy", "false");
    submitBtn.classList.add("success");
    btnContent.innerHTML = `<span aria-hidden="true">✓</span> enlace creado`;
  }

  function resetButton() {
    submitBtn.classList.remove("loading", "success");
    submitBtn.setAttribute("aria-busy", "false");
    submitBtn.disabled = urlInput.value.trim() === "";
    btnContent.innerHTML = `<span class="lf-arrow">→</span> crear link`;
  }

  function showResult(url: string, alias: string) {
    resultUrl.href        = url;
    resultUrl.textContent = url;
    statsLink.href        = `/stats?alias=${encodeURIComponent(alias)}`;
    resultBlock.classList.remove("hidden");
  }

  function hideResult() {
    resultBlock.classList.add("hidden");
  }

  function showError(message: string) {
    errorMsg.textContent = message;
    errorBlock.classList.remove("hidden");
  }

  function hideError() {
    errorBlock.classList.add("hidden");
  }

  copyBtn.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(resultUrl.href);
      copyIcon.textContent = "✓";
      copyBtn.classList.add("copied");
      setTimeout(() => {
        copyIcon.textContent = "⎘";
        copyBtn.classList.remove("copied");
      }, 2000);
    } catch {
      const tmp = document.createElement("input");
      tmp.value = resultUrl.href;
      document.body.appendChild(tmp);
      tmp.select();
      document.execCommand("copy");
      document.body.removeChild(tmp);
    }
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const url   = urlInput.value.trim();
    const alias = aliasInput.value.trim();
    if (!url) return;

    hideResult();
    hideError();
    setLoading();

    const result = await createLink(url, alias);

    if ("error" in result) {
      const errorText = Array.isArray(result.error)
        ? result.error.map((e) => e.message).join(" · ")
        : result.error;

      resetButton();
      showError(errorText);
      return;
    }

    setSuccess();
    showResult(result.shortUrl, result.data.alias);
    form.reset();
    updateAliasCounter();
    submitBtn.disabled = true;

    setTimeout(resetButton, 3000);
  });
</script>
